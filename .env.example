# Core
SECRET_KEY=replace-with-a-long-random-value
DATABASE_PATH=/var/data/contractsweep.db
BASE_URL=http://localhost:5000
BRAND_NAME=ContractSweep
ADMIN_TOKEN=replace-with-a-long-random-admin-token
TASK_TOKEN=replace-with-a-separate-long-random-task-token
ENABLE_PUBLIC_DEMO=true
DEMO_MODE=true
SESSION_COOKIE_SECURE=false

# Data ingestion
SAM_API_KEY=
SAM_LOOKBACK_DAYS=120
SAM_NAICS_CODES=561720,561210,561790,561740
DELETE_DEMO_ON_SYNC=true

# Payments
STRIPE_PAYMENT_LINK=https://buy.stripe.com/replace_me
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_LINK_ID=

# Email
RESEND_API_KEY=
EMAIL_FROM=ContractSweep <alerts@example.com>
SUPPORT_EMAIL=support@example.com

# Legal seller and policy launch gate
LEGAL_SELLER_NAME=
LEGAL_MAILING_ADDRESS=
LEGAL_EFFECTIVE_DATE=August 1, 2026
LEGAL_GOVERNING_LAW=Minnesota
LEGAL_PAGES_APPROVED=false

# Product settings
FOUNDING_PRICE=79
DEFAULT_MIN_SCORE=50
DIGEST_MAX_ITEMS=12
